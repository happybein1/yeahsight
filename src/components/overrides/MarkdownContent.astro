---
import type { Props } from '@astrojs/starlight/props';
// Starlight's own MarkdownContent imports this; overriding the component dropped it, which removed
// paragraph spacing and heading sizes site-wide until v2.20.
import '@astrojs/starlight/style/markdown.css';

import { pick, homeOf } from '../../i18n';
const lang = Astro.locals.starlightRoute.lang;
const readLabel = pick(lang, { en: 'read', fr: 'de lecture', es: 'de lectura', nl: 'lezen' });
const kind = (Astro.locals.starlightRoute.entry.data as any).kind as ('explainer' | 'proposal' | undefined);
const KIND = {
  explainer: pick(lang, {
    en: { label: 'Explainer', hint: 'Facts, how it works and the options, without taking a side.' },
    fr: { label: 'Explication', hint: 'Faits, fonctionnement et options, sans prise de position.' },
    es: { label: 'Explicación', hint: 'Hechos, cómo funciona y las opciones, sin tomar partido.' },
    nl: { label: 'Uitleg', hint: 'Feiten, hoe het werkt en de mogelijkheden, zonder partij te kiezen.' },
  }),
  // v2.33: shown as "recommendation" (the front matter value stays 'proposal').
  proposal: pick(lang, {
    en: { label: 'HappyBein recommendation', hint: 'What we recommend, and why. Open for discussion.' },
    fr: { label: 'Recommandation HappyBein', hint: 'Ce que nous recommandons, et pourquoi. Ouvert à la discussion.' },
    es: { label: 'Recomendación de HappyBein', hint: 'Lo que recomendamos, y por qué. Abierto a debate.' },
    nl: { label: 'Aanbeveling van HappyBein', hint: 'Wat we aanbevelen, en waarom. Open voor discussie.' },
  }),
};
const k = kind ? KIND[kind] : null;
const audio = (Astro.locals.starlightRoute.entry.data as any).audio as (string | undefined);
const audioMin = (Astro.locals.starlightRoute.entry.data as any).audioMinutes as (number | undefined);
const audioLabel = pick(lang, { en: 'Listen to this article', fr: 'Écouter cet article', es: 'Escuchar este artículo', nl: 'Luister naar dit artikel' });
// v2.52: the episodes are Emma and Sam dialogs (an audio file named .en.mp3 or -dialog.en.mp3 from v2.50 on);
// a single-voice reading keeps the old line.
const dialog = !!audio && !/\/(vision-roadmap|making-the-transition|transition-in-practice)\.(en|fr)\.mp3$/.test(audio);
const audioBy = dialog
  ? pick(lang, { en: 'A conversation between Emma and Sam, AI voices', fr: 'Une conversation entre Emma et Sam, voix IA', es: 'Una conversación entre Emma y Sam, voces de IA', nl: 'Een gesprek tussen Emma en Sam, AI-stemmen' })
  : pick(lang, { en: 'Read by the YeahSight voice', fr: 'Lu par la voix YeahSight', es: 'Leído por la voz de YeahSight', nl: 'Voorgelezen door de YeahSight-stem' });
// v2.46 (owner): which of the six home-page questions this article belongs to, from the menu group.
type E = { type: string; label: string; isCurrent?: boolean; entries?: E[] };
const has = (e: E): boolean => !!e.isCurrent || (e.entries || []).some(has);
const q = (Astro.locals.starlightRoute.sidebar as E[]).find((e) => e.type === 'group' && /^\d\./.test(e.label) && has(e));
const qNum = q ? q.label.split('.')[0] : '';
const qText = q ? q.label.replace(/^\d\.\s*/, '') : '';
const storyHref = homeOf(lang);
---

{q && (
  <p class="yv-story">{pick(lang, { en: `Question ${qNum} of 6: `, fr: `Question ${qNum} sur 6 : `, es: `Pregunta ${qNum} de 6: `, nl: `Vraag ${qNum} van 6: ` })}<em>{qText}</em> · <a href={storyHref}>{pick(lang, { en: 'The whole story', fr: "Toute l'histoire", es: 'Toda la historia', nl: 'Het hele verhaal' })}</a></p>
)}

{k && (
  <div class={`yv-kind yv-kind-${kind}`}>
    <span class="yv-kind-badge">{`${kind === 'proposal' ? '💡' : '📘'} ${k.label}`}</span>
    <span class="yv-kind-hint">{k.hint}</span>
  </div>
)}

<div class="yv-reading-time" id="yv-reading-time" aria-label="Reading time">
  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/></svg>
  <span id="yv-rt-text">...</span>
</div>

{audio && (
  <div class="yv-audio">
    <div class="yv-audio-head">🎧 <strong>{audioLabel}</strong>{audioMin && <span>{` · ${audioMin} min`}</span>}<span class="yv-audio-by">{audioBy}</span></div>
    <audio controls preload="none" src={audio}></audio>
  </div>
)}

<div class="sl-markdown-content"><slot /></div>

<style>
  .yv-story { font-size: .8rem; color: var(--sl-color-gray-3); margin: -.25rem 0 .5rem; }
  .yv-story a { color: var(--sl-color-accent-high); }
  .yv-audio { margin: 0 0 1.25rem; padding: .75rem .9rem; border-radius: 14px; border: 1px solid var(--sl-color-hairline); background: var(--sl-color-bg-nav); }
  .yv-audio-head { font-size: .85rem; margin-bottom: .45rem; display: flex; flex-wrap: wrap; gap: .25rem .4rem; align-items: baseline; }
  .yv-audio-by { color: var(--sl-color-gray-3); font-size: .78rem; margin-left: auto; }
  .yv-audio audio { width: 100%; }
  .yv-kind { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem .6rem; margin: -.25rem 0 .6rem; font-size: .8rem; }
  .yv-kind-badge { font-weight: 700; padding: .18rem .6rem; border-radius: 999px; border: 1px solid; }
  .yv-kind-explainer .yv-kind-badge { color: var(--sl-color-accent-high); border-color: var(--sl-color-accent); background: var(--sl-color-accent-low); }
  .yv-kind-proposal .yv-kind-badge { color: #7a4a00; border-color: #f2b84b; background: #fff3d6; }
  :global([data-theme='dark']) .yv-kind-proposal .yv-kind-badge { color: #ffd98a; border-color: #b8862a; background: #3a2a0a; }
  .yv-kind-hint { color: var(--sl-color-gray-3); }
  .yv-reading-time {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    color: var(--sl-color-gray-3);
    margin-bottom: 1.25rem;
    margin-top: -0.25rem;
  }
</style>

<script define:vars={{ readLabel }}>
  document.addEventListener('DOMContentLoaded', function () {
    const content = document.querySelector('.sl-markdown-content');
    const el = document.getElementById('yv-rt-text');
    if (!content || !el) return;
    // Directory pages (v2.19) are lists to browse, not text to read: no reading time.
    if (content.querySelector('.org-dir')) { document.getElementById('yv-reading-time')?.remove(); return; }

    const words = content.innerText.trim().split(/\s+/).length;
    const mins = Math.max(1, Math.round(words / 200));
    el.textContent = `${mins} min ${readLabel}`;
  });
</script>
