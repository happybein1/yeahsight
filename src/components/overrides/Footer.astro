---
import type { Props } from '@astrojs/starlight/props';
import { SITE_VERSION, SITE_VERSION_DATE, SITE_VERSION_NOTES } from '../../version';

const isFr = Astro.locals.starlightRoute.lang === 'fr';
const label = isFr ? 'Version' : 'Version';
const builtWith = isFr ? 'Construit avec' : 'Built with';
const contactLabel = isFr ? 'Nous contacter' : 'Contact us';
const checkLabel = isFr ? 'Je ne suis pas un robot' : 'I am not a robot';
const revealLabel = isFr ? 'Écrivez-nous à :' : 'Write to us at:';
const instrLabel = isFr ? 'Cochez la case pour afficher notre adresse e-mail.' : 'Tick the box to reveal our email address.';
---

<footer class="yv-footer">
  <div class="yv-footer-inner">
    <span class="yv-version" title={`${SITE_VERSION_NOTES} · ${SITE_VERSION_DATE}`}>
      <span class="yv-version-dot"></span>
      {label} {SITE_VERSION}
      <span class="yv-version-date">· {SITE_VERSION_DATE}</span>
    </span>
    <div class="yv-footer-social">
      <a href="https://github.com/happybein1/yeahsight" target="_blank" rel="noopener" aria-label="GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.342-3.369-1.342-.454-1.155-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
      </a>
      <a href="https://discord.com/invite/62xRJHCbRW" target="_blank" rel="noopener" aria-label="Discord">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.043.033.055a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
      </a>
    </div>
    <button id="yv-contact-btn" class="yv-contact-trigger">✉ {contactLabel}</button>
    <button type="button" class="yv-contact-trigger" onclick="window.yvConsentOpen&&window.yvConsentOpen();">🍪 {isFr ? 'Cookies' : 'Cookie settings'}</button>
    <span class="yv-footer-built">
      {builtWith} <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> &amp; <a href="https://starlight.astro.build" target="_blank" rel="noopener">Starlight</a>
    </span>
  </div>

  <!-- Modal -->
  <div id="yv-modal-backdrop" class="yv-modal-backdrop" aria-hidden="true"></div>
  <div id="yv-contact-modal" class="yv-modal-box" role="dialog" aria-modal="true" aria-hidden="true">
    <button class="yv-modal-close" id="yv-modal-close" aria-label="Close">✕</button>
    <h3>✉ {contactLabel}</h3>
    <p class="yv-modal-instr">{instrLabel}</p>

    <label class="yv-robot-check" id="yv-check-label">
      <span class="yv-checkbox-wrap">
        <input type="checkbox" id="yv-not-robot" />
        <span class="yv-checkbox-box"></span>
      </span>
      <span>{checkLabel}</span>
    </label>

    <div id="yv-email-reveal" class="yv-email-box" aria-hidden="true">
      <a id="yv-email-link" href="#" class="yv-email-addr"></a>
    </div>
  </div>
</footer>

<style>
  /* Footer layout */
  .yv-footer {
    border-top: 1px solid var(--sl-color-hairline);
    padding: 1rem var(--sl-content-pad-x);
    margin-top: 2rem;
  }
  .yv-footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    max-width: var(--sl-content-width);
    margin-inline: auto;
    font-size: 0.78rem;
    color: var(--sl-color-gray-3);
  }

  /* Version badge */
  .yv-version {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.75rem;
  }
  .yv-version-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    flex-shrink: 0;
  }
  .yv-version-date { color: var(--sl-color-gray-4); }

  /* Contact button */
  .yv-contact-trigger {
    background: none;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 2rem;
    color: var(--sl-color-gray-3);
    cursor: pointer;
    font-size: 0.78rem;
    padding: 0.3rem 0.85rem;
    transition: border-color 0.2s, color 0.2s;
  }
  .yv-contact-trigger:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
  }

  /* Built with */
  .yv-footer-built a { color: var(--sl-color-gray-3); text-decoration: none; }
  .yv-footer-built a:hover { color: var(--sl-color-accent); }
  @media (max-width: 50rem) { .yv-footer-built { display: none; } }

  /* Social icons in footer */
  .yv-footer-social {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }
  .yv-footer-social a {
    color: var(--sl-color-gray-3);
    display: flex;
    align-items: center;
    transition: color 0.2s;
  }
  .yv-footer-social a:hover { color: var(--sl-color-accent); }

  /* Backdrop */
  .yv-modal-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.55);
    z-index: 9998;
  }
  .yv-modal-backdrop.open { display: block; }

  /* Modal box */
  .yv-modal-box {
    display: none;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 9999;
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 14px;
    padding: 2rem 2rem 1.75rem;
    width: min(360px, 90vw);
    box-shadow: 0 12px 40px rgba(0,0,0,0.4);
  }
  .yv-modal-box.open { display: block; }

  .yv-modal-close {
    position: absolute;
    top: 0.75rem;
    right: 0.9rem;
    background: none;
    border: none;
    color: var(--sl-color-gray-3);
    cursor: pointer;
    font-size: 1.1rem;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
  }
  .yv-modal-close:hover { background: var(--sl-color-bg-inline-code); }

  .yv-modal-box h3 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    color: var(--sl-color-text);
  }
  .yv-modal-instr {
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
    margin: 0 0 1.25rem;
    line-height: 1.5;
  }

  /* Checkbox */
  .yv-robot-check {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    font-size: 0.9rem;
    color: var(--sl-color-text);
    user-select: none;
    padding: 0.75rem 1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 8px;
    background: var(--sl-color-bg-sidebar);
    transition: border-color 0.2s;
  }
  .yv-robot-check:hover { border-color: var(--sl-color-accent); }

  .yv-checkbox-wrap { position: relative; flex-shrink: 0; }
  .yv-checkbox-wrap input { position: absolute; opacity: 0; width: 0; height: 0; }
  .yv-checkbox-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border: 2px solid var(--sl-color-gray-3);
    border-radius: 4px;
    background: var(--sl-color-bg);
    transition: border-color 0.2s, background 0.2s;
  }
  .yv-checkbox-wrap input:checked + .yv-checkbox-box {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent);
  }
  .yv-checkbox-wrap input:checked + .yv-checkbox-box::after {
    content: '';
    display: block;
    width: 5px;
    height: 9px;
    border: 2px solid #fff;
    border-top: none;
    border-left: none;
    transform: rotate(45deg) translateY(-1px);
  }

  /* Email reveal */
  .yv-email-box {
    display: none;
    margin-top: 1.1rem;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-accent);
    text-align: center;
  }
  .yv-email-box.visible { display: block; }
  .yv-email-addr {
    font-size: 1rem;
    font-weight: 600;
    color: var(--sl-color-accent);
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  .yv-email-addr:hover { text-decoration: underline; }
</style>

<script>
  const btn       = document.getElementById('yv-contact-btn');
  const modal     = document.getElementById('yv-contact-modal');
  const backdrop  = document.getElementById('yv-modal-backdrop');
  const closeBtn  = document.getElementById('yv-modal-close');
  const checkbox  = document.getElementById('yv-not-robot');
  const emailBox  = document.getElementById('yv-email-reveal');
  const emailLink = document.getElementById('yv-email-link');

  // Email split to prevent scraping
  const u = 'happybein1';
  const d = 'gmail.com';

  function openModal() {
    modal?.classList.add('open');
    backdrop?.classList.add('open');
    modal?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }
  function closeModal() {
    modal?.classList.remove('open');
    backdrop?.classList.remove('open');
    modal?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    // Reset state
    if (checkbox) (checkbox as HTMLInputElement).checked = false;
    emailBox?.classList.remove('visible');
  }

  btn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  backdrop?.addEventListener('click', closeModal);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

  checkbox?.addEventListener('change', function() {
    if ((this as HTMLInputElement).checked) {
      const email = `${u}@${d}`;
      if (emailLink) {
        emailLink.href = `mailto:${email}`;
        emailLink.textContent = email;
      }
      emailBox?.classList.add('visible');
    } else {
      emailBox?.classList.remove('visible');
    }
  });
</script>
