  }
  function read() {
    var raw = null, m = d.cookie.match(/(?:^|; )yv_consent=([^;]*)/);
    if (m) raw = decodeURIComponent(m[1]);
    if (!raw) { try { raw = w.localStorage.getItem(KEY); } catch (e) {} }
    if (!raw) return null;
    var parts = raw.split(':'), v = parts[0], ts = +parts[1] || 0;
    if ((v !== 'granted' && v !== 'denied') || !ts || Date.now() - ts > DAYS * 864e5) return null;
