      if (!loaded) {
        // Drop events queued before consent was given; only 'js' / 'config' / 'set' / consent entries are replayed.
        for (var i = w.dataLayer.length - 1; i >= 0; i--) { var q = w.dataLayer[i]; if (q && q[0] === 'event') w.dataLayer.splice(i, 1); }
        def.analytics_storage = 'granted'; loadGA();   // queued 'default' entry is replayed as granted
      }
      else { w['ga-disable-' + GA] = false; gtag('consent', 'update', { analytics_storage: 'granted' }); }
    } else {
      w['ga-disable-' + GA] = true;
      if (loaded) gtag('consent', 'update', { analytics_storage: 'denied' });
      clearGaCookies();
    }
  }
  if (stored === 'granted') loadGA();
  if (stored === 'denied') w['ga-disable-' + GA] = true;

  /* ---- banner ---- */
  var box = null;
  function lang() {
    var l = (d.documentElement.lang || w.navigator.language || 'en').slice(0, 2).toLowerCase();
    return TEXT[l] || TEXT.en;
  }
  function css() {
    if (d.getElementById('yvc-css')) return;
    var s = d.createElement('style');
    s.id = 'yvc-css';
    s.textContent =
      '#yvc{position:fixed;left:12px;right:12px;bottom:calc(env(safe-area-inset-bottom,0px) + 12px);z-index:2147483000;max-width:520px;margin:0 auto;box-sizing:border-box;padding:14px 16px;border-radius:14px;' +
      'font:14px/1.45 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:#fff;color:#1f2933;border:1px solid #d5dde0;box-shadow:0 6px 28px rgba(0,0,0,.28)}' +
      '#yvc p{margin:0 0 12px}#yvc a{color:#0f8f8f;text-decoration:underline}' +
      '#yvc .yvc-b{display:flex;gap:10px}#yvc button{flex:1;min-height:44px;border-radius:10px;font:700 15px system-ui,-apple-system,Segoe UI,Roboto,sans-serif;cursor:pointer;border:2px solid #2ABFBF}' +
      '#yvc .yvc-a{background:#2ABFBF;color:#04302f}#yvc .yvc-r{background:transparent;color:inherit}' +
      '@media (prefers-color-scheme:dark){#yvc{background:#1b2423;color:#e8f0ef;border-color:#33423f}#yvc a{color:#6fdcd8}#yvc .yvc-a{color:#04302f}}';
    (d.head || d.documentElement).appendChild(s);
  }
  function close() { if (box && box.parentNode) box.parentNode.removeChild(box); box = null; }
  function show() {
    if (box || !d.body) return;
    css();
    var t = lang();
    box = d.createElement('div');
    box.id = 'yvc';
    box.setAttribute('role', 'dialog');
    box.setAttribute('aria-label', t.h);
    box.innerHTML = '<p>' + t.t + (PRIVACY ? ' <a href="' + PRIVACY + '" target="_blank" rel="noopener">' + t.p + '</a>' : '') + '</p>' +
      '<div class="yvc-b"><button type="button" class="yvc-r">' + t.r + '</button><button type="button" class="yvc-a">' + t.a + '</button></div>';
    box.querySelector('.yvc-a').onclick = function () { write('granted'); apply('granted'); close(); };
    box.querySelector('.yvc-r').onclick = function () { write('denied'); apply('denied'); close(); };
    d.body.appendChild(box);
  }
  function ready(fn) { if (d.body) fn(); else d.addEventListener('DOMContentLoaded', fn); }

  w.yvConsentOpen = function () { ready(show); };
  w.yvConsentState = function () { return read(); };
  var wantsOpen = /(?:[?&#])cookie-settings\b/.test(w.location.search + w.location.hash);
  if (!stored || wantsOpen) ready(show);
})(window, document);
</script>
<!-- GA4 config, with the owner-traffic marker (yv-internal v2; source: _shared/internal.js) -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  (function (w, d) {
    var p = w.location.hostname.split('.'), dom = p.length >= 2 && !/^[\d.]+$/.test(w.location.hostname) ? '; domain=.' + p.slice(-2).join('.') : '';
    var m = (w.location.search.match(/[?&]internal(?:=([^&]*))?(?:&|$)/) || [])[0], on = null;
    if (m) on = !/=off/.test(m);
    if (on !== null) {
      try { d.cookie = 'yv_internal=' + (on ? '1' : '') + '; max-age=' + (on ? 31536000 : 0) + '; path=/' + dom + '; SameSite=Lax' + (w.location.protocol === 'https:' ? '; Secure' : ''); } catch (e) {}
      try { if (on) w.localStorage.setItem('yv_internal', '1'); else w.localStorage.removeItem('yv_internal'); } catch (e) {}
    }
    var internal = false;
    try { internal = w.localStorage.getItem('yv_internal') === '1'; } catch (e) {}
    if (!internal) internal = /(?:^|;\s*)yv_internal=1/.test(d.cookie || '');
    gtag('config', 'G-TJFL5YQ705', internal ? { anonymize_ip: true, traffic_type: 'internal' } : { anonymize_ip: true });
    if (internal) gtag('set', 'user_properties', { internal_user: 'true' });
    var here = p.slice(-2).join('.');
    var CF = { 'happybein.com': 'bc29302dbc214188aebf56490bf4cef4' }[here];
    if (CF && !internal) {
      var b = d.createElement('script');
      b.defer = true; b.src = 'https://static.cloudflareinsights.com/beacon.min.js';
      b.setAttribute('data-cf-beacon', JSON.stringify({ token: CF }));
      (d.head || d.documentElement).appendChild(b);
    }
