---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Head.astro';

// Starlight 0.32+ passes route data via Astro.locals, not props.
const route = Astro.locals.starlightRoute;
const { entry, lang } = route;

// Drop Starlight's own title/description/canonical/OG/Twitter tags; this file sets them below.
// Without this, every page carried two sets and the site-wide defaults won over the article's own.
route.head = route.head.filter((t) => {
  const a = t.attrs || {};
  if (t.tag === 'title') return false;
  if (t.tag === 'link' && a.rel === 'canonical') return false;
  if (t.tag === 'meta' && (a.name === 'description' || String(a.property || '').startsWith('og:') || String(a.name || '').startsWith('twitter:'))) return false;
  return true;
});

const siteUrl = 'https://yeahsight.happybein.com';
const currentPath = Astro.url.pathname;
const currentUrl = new URL(currentPath, siteUrl).toString();
const ogImage = `${siteUrl}/og-card.png`;
const isFr = lang === 'fr';

const siteNameEN = 'YeahSight by HappyBein';
const siteNameFR = 'YeahSight par HappyBein';

// Page title — append site name for SEO unless it's already the homepage
const rawTitle = entry?.data?.title ?? 'YeahSight';
const isHome = currentPath === '/' || currentPath === '/fr/' || currentPath === '/fr';
const seoTitle = isHome
  ? (isFr ? 'YeahSight — Comprendre la société et où elle va' : 'YeahSight — Understand society and where it is heading')
  : `${rawTitle} | ${isFr ? siteNameFR : siteNameEN}`;

// Meta description — richer default with keywords
const defaultDescEN = 'YeahSight gives a clear, structured view of how society works and where it is heading: environment, energy, economy, technology and social organization. By HappyBein.';
const defaultDescFR = 'YeahSight offre une vue claire et structurée du fonctionnement de la société et de son évolution : environnement, énergie, économie, technologie et organisation sociale. Par HappyBein.';
const description = entry?.data?.description ?? (isFr ? defaultDescFR : defaultDescEN);

// Keywords
const keywordsEN = 'foresight, society, trends, environment, energy, economy, equity, automation, artificial intelligence, social organization, YeahSight, HappyBein';
const keywordsFR = 'prospective, société, tendances, environnement, énergie, économie, équité, automatisation, intelligence artificielle, organisation sociale, YeahSight, HappyBein';

// Build hreflang URLs
const enUrl = currentUrl.replace('/fr/', '/').replace(/\/fr$/, '/');
const frUrl = currentPath.startsWith('/fr')
  ? currentUrl
  : `${siteUrl}/fr${currentPath === '/' ? '/' : currentPath}`;
---
<Default {...Astro.props} />

<!-- Favicons — override Starlight default -->
<!-- v2.31: ?v= on the icon URLs so browsers that saved the old eye logo fetch the sunrise one;
     the manifest gives phones a proper name and icon when installing. -->
<link rel="icon" type="image/x-icon" href="/favicon.ico?v=2.31" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png?v=2.31" />
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png?v=2.31" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2.31" />
<link rel="manifest" href="/manifest.webmanifest" />

<!-- SEO Core -->
<title>{seoTitle}</title>
<meta name="description" content={description} />
<meta name="keywords" content={isFr ? keywordsFR : keywordsEN} />
<meta name="author" content="YeahSight — HappyBein" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="theme-color" content="#0e7fbe" />

<!-- Canonical -->
<link rel="canonical" href={currentUrl} />

<!-- Hreflang -->
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="fr" href={frUrl} />
<link rel="alternate" hreflang="x-default" href={enUrl} />

<!-- Podcast feed (v2.23), lets podcast apps and browsers find it from any page -->
<link rel="alternate" type="application/rss+xml" title={isFr ? 'YeahSight (en français), podcast' : 'YeahSight podcast'} href={`${siteUrl}/podcast/${isFr ? 'fr' : 'en'}.xml`} />

<!-- Open Graph -->
<meta property="og:title" content={seoTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={currentUrl} />
<meta property="og:type" content="website" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="2400" />
<meta property="og:image:height" content="1260" />
<meta property="og:image:alt" content="YeahSight — Understand society and where it is heading" />
<meta property="og:locale" content={isFr ? 'fr_FR' : 'en_US'} />
<meta property="og:locale:alternate" content={isFr ? 'en_US' : 'fr_FR'} />
<meta property="og:site_name" content={isFr ? siteNameFR : siteNameEN} />

<!-- Twitter / X Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seoTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content="YeahSight — Understand society and where it is heading" />
<meta name="twitter:site" content="@yeahvibe" />
<meta name="twitter:creator" content="@happybein" />

<!-- Google Analytics -->
<!-- GA4 loads only after the visitor accepts (yv-consent v1; source: _shared/consent.js) -->
<script is:inline>
(function (w, d) {
  var GA = 'G-TJFL5YQ705', PRIVACY = 'https://happybein.com/privacy', KEY = 'yv_consent', DAYS = 180;
  var TEXT = {
    en: { t: 'We would like to use Google Analytics (cookies) to see which parts of this site get used. No ads, and your data is never sold. You can change your mind at any time.', a: 'Accept', r: 'Decline', p: 'Privacy policy', h: 'Cookies' },
    nl: { t: 'We willen Google Analytics (cookies) gebruiken om te zien welke onderdelen van deze site worden gebruikt. Geen advertenties en je gegevens worden nooit verkocht. Je kunt je keuze altijd wijzigen.', a: 'Accepteren', r: 'Weigeren', p: 'Privacybeleid', h: 'Cookies' },
    fr: { t: 'Nous aimerions utiliser Google Analytics (cookies) pour savoir quelles parties du site sont utilisées. Pas de publicité, et vos données ne sont jamais vendues. Vous pouvez changer d’avis à tout moment.', a: 'Accepter', r: 'Refuser', p: 'Politique de confidentialité', h: 'Cookies' },
    es: { t: 'Nos gustaría usar Google Analytics (cookies) para saber qué partes del sitio se utilizan. Sin anuncios y tus datos nunca se venden. Puedes cambiar de opinión en cualquier momento.', a: 'Aceptar', r: 'Rechazar', p: 'Política de privacidad', h: 'Cookies' }
  };

  /* ---- stored choice ---- */
  function cookieDomain() {
    var h = w.location.hostname, p = h.split('.');
    if (p.length < 2 || /^[\d.]+$/.test(h) || h === 'localhost') return '';
