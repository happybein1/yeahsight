---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Head.astro';

// Starlight 0.32+ passes route data via Astro.locals, not props.
const route = Astro.locals.starlightRoute;
const { entry, lang } = route;

// Drop Starlight's own title/description/canonical/OG/Twitter tags; this file sets them below.
// Without this, every page carried two sets and the site-wide defaults won over the article's own.
route.head = route.head.filter((t) => {
  const a = t.attrs || {};
  if (t.tag === 'title') return false;
  if (t.tag === 'link' && a.rel === 'canonical') return false;
  if (t.tag === 'meta' && (a.name === 'description' || String(a.property || '').startsWith('og:') || String(a.name || '').startsWith('twitter:'))) return false;
  return true;
});

const siteUrl = 'https://yeahsight.happybein.com';
const currentPath = Astro.url.pathname;
const currentUrl = new URL(currentPath, siteUrl).toString();
const ogImage = `${siteUrl}/og-card.png`;
const isFr = lang === 'fr';

const siteNameEN = 'YeahSight by HappyBein';
const siteNameFR = 'YeahSight par HappyBein';

// Page title — append site name for SEO unless it's already the homepage
const rawTitle = entry?.data?.title ?? 'YeahSight';
const isHome = currentPath === '/' || currentPath === '/fr/' || currentPath === '/fr';
const seoTitle = isHome
  ? (isFr ? 'YeahSight — Comprendre la société et où elle va' : 'YeahSight — Understand society and where it is heading')
  : `${rawTitle} | ${isFr ? siteNameFR : siteNameEN}`;

// Meta description — richer default with keywords
const defaultDescEN = 'YeahSight gives a clear, structured view of how society works and where it is heading: environment, energy, economy, technology and social organization. By HappyBein.';
const defaultDescFR = 'YeahSight offre une vue claire et structurée du fonctionnement de la société et de son évolution : environnement, énergie, économie, technologie et organisation sociale. Par HappyBein.';
const description = entry?.data?.description ?? (isFr ? defaultDescFR : defaultDescEN);

// Keywords
const keywordsEN = 'foresight, society, trends, environment, energy, economy, equity, automation, artificial intelligence, social organization, YeahSight, HappyBein';
const keywordsFR = 'prospective, société, tendances, environnement, énergie, économie, équité, automatisation, intelligence artificielle, organisation sociale, YeahSight, HappyBein';

// Build hreflang URLs
const enUrl = currentUrl.replace('/fr/', '/').replace(/\/fr$/, '/');
const frUrl = currentPath.startsWith('/fr')
  ? currentUrl
  : `${siteUrl}/fr${currentPath === '/' ? '/' : currentPath}`;
---
<Default {...Astro.props} />

<!-- Favicons — override Starlight default -->
<!-- v2.31: ?v= on the icon URLs so browsers that saved the old eye logo fetch the sunrise one;
     the manifest gives phones a proper name and icon when installing. -->
<link rel="icon" type="image/x-icon" href="/favicon.ico?v=2.31" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png?v=2.31" />
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png?v=2.31" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2.31" />
<link rel="manifest" href="/manifest.webmanifest" />

<!-- SEO Core -->
<title>{seoTitle}</title>
<meta name="description" content={description} />
<meta name="keywords" content={isFr ? keywordsFR : keywordsEN} />
<meta name="author" content="YeahSight — HappyBein" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="theme-color" content="#0e7fbe" />

<!-- Canonical -->
<link rel="canonical" href={currentUrl} />

<!-- Hreflang -->
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="fr" href={frUrl} />
<link rel="alternate" hreflang="x-default" href={enUrl} />

<!-- Podcast feed (v2.23), lets podcast apps and browsers find it from any page -->
<link rel="alternate" type="application/rss+xml" title={isFr ? 'YeahSight (en français), podcast' : 'YeahSight podcast'} href={`${siteUrl}/podcast/${isFr ? 'fr' : 'en'}.xml`} />

<!-- Open Graph -->
<meta property="og:title" content={seoTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={currentUrl} />
<meta property="og:type" content="website" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="2400" />
<meta property="og:image:height" content="1260" />
<meta property="og:image:alt" content="YeahSight — Understand society and where it is heading" />
<meta property="og:locale" content={isFr ? 'fr_FR' : 'en_US'} />
<meta property="og:locale:alternate" content={isFr ? 'en_US' : 'fr_FR'} />
<meta property="og:site_name" content={isFr ? siteNameFR : siteNameEN} />

<!-- Twitter / X Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seoTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content="YeahSight — Understand society and where it is heading" />
<meta name="twitter:site" content="@yeahvibe" />
<meta name="twitter:creator" content="@happybein" />

<!-- Google Analytics -->
<!-- Visit counts (Cloudflare Web Analytics, cookieless) + owner-traffic marker (yv-internal v5; source: _shared/internal.js) -->
<script is:inline>
  (function (w, d) {
    var p = w.location.hostname.split('.'), dom = p.length >= 2 && !/^[\d.]+$/.test(w.location.hostname) ? '; domain=.' + p.slice(-2).join('.') : '';
    var here = p.slice(-2).join('.');
    var m = (w.location.search.match(/[?&]internal(?:=([^&]*))?(?:&|$)/) || [])[0], on = null;
    if (m) on = !/=off/.test(m);
    if (on !== null) {
      try { d.cookie = 'yv_internal=' + (on ? '1' : '') + '; max-age=' + (on ? 31536000 : 0) + '; path=/' + dom + '; SameSite=Lax' + (w.location.protocol === 'https:' ? '; Secure' : ''); } catch (e) {}
      try { if (on) w.localStorage.setItem('yv_internal', '1'); else w.localStorage.removeItem('yv_internal'); } catch (e) {}
    }
    var internal = false;
    try { internal = w.localStorage.getItem('yv_internal') === '1'; } catch (e) {}
    if (!internal) internal = /(?:^|;\s*)yv_internal=1/.test(d.cookie || '');
    if (here !== 'yeahvibe.com') {
      try {
        d.cookie.split('; ').map(function (c) { return c.split('=')[0]; })
          .filter(function (n) { return n === '_ga' || n.indexOf('_ga_') === 0 || n === '_gid' || n === 'yv_consent'; })
          .forEach(function (n) { ['', '; domain=' + w.location.hostname, dom].forEach(function (x) { d.cookie = n + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/' + x; }); });
        w.localStorage.removeItem('yv_consent');
      } catch (e) {}
    }
    var CF = { 'happybein.com': 'bc29302dbc214188aebf56490bf4cef4', 'yeahdev.com': 'eb13518849014d5e9fd376c4202f3432', 'yeahvibe.com': '55aea6e64e384cf7b021e272ff38d389' }[here];
    if (CF && !internal) {
      var b = d.createElement('script');
      b.defer = true; b.src = 'https://static.cloudflareinsights.com/beacon.min.js';
      b.setAttribute('data-cf-beacon', JSON.stringify({ token: CF }));
      (d.head || d.documentElement).appendChild(b);
    }
    if (on === null && !internal) return;
    var others = ['happybein.com', 'yeahvibe.com', 'yeahdev.com'].filter(function (x) { return x !== here; });
    var A = 'style="color:#6fdcd8"';
    function pill() {
      if (!internal) return;
      var v = d.querySelector('#version-refresh, .yv-version, .header-version, .ver, .version');
      if (v) {
        var cs = w.getComputedStyle(v), dot = d.createElement('span');
        if (cs.position === 'static') v.style.position = 'relative';
        dot.setAttribute('aria-hidden', 'true');
        dot.style.cssText = 'position:absolute;left:50%;top:calc(100% - ' + (parseFloat(cs.paddingBottom) || 0) + 'px + 1px);width:5px;height:5px;margin-left:-2.5px;border-radius:50%;background:#2ABFBF;pointer-events:none';
        v.appendChild(dot);
        v.title = (v.title ? v.title + ' · ' : '') + 'Internal: your visits are not counted in the analytics';
        return;
      }
      var b = d.createElement('button');
      b.type = 'button';
      b.innerHTML = '&#9679; internal';
      b.title = 'This browser is marked as internal: your visits are not counted in the analytics';
      b.style.cssText = 'position:fixed;left:8px;bottom:calc(env(safe-area-inset-bottom,0px) + 8px);z-index:2147482999;padding:3px 9px;border-radius:999px;border:0;font:600 11px/1.4 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:#1A3333;color:#6fdcd8;opacity:.75;cursor:pointer';
      b.onclick = function () { b.remove(); note(true); };
      d.body.appendChild(b);
    }
    function note(info) {
      var n = d.createElement('div');
      n.setAttribute('role', 'status');
      n.style.cssText = 'position:fixed;left:12px;right:12px;top:calc(env(safe-area-inset-top,0px) + 12px);z-index:2147483001;max-width:520px;margin:0 auto;padding:12px 16px;border-radius:12px;font:14px/1.45 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:#1A3333;color:#fff;box-shadow:0 6px 28px rgba(0,0,0,.28)';
      n.innerHTML = (info ? 'This browser is marked as <b>internal</b> on ' + here + ': your visits are left out of the analytics. <a ' + A + ' href="' + w.location.pathname + '?internal=off">Remove the mark</a>'
                   : on ? '&#10003; This browser is now marked as <b>internal</b> on ' + here + ': your visits are left out of the analytics.'
                        : 'The internal mark is removed on ' + here + ': your visits count again.') +
        (info ? '' : ' Also on: ' + others.map(function (x) { return '<a ' + A + ' href="https://' + x + '/?internal' + (on ? '' : '=off') + '">' + x + '</a>'; }).join(' &middot; ')) +
        ' <button type="button" aria-label="Close" style="float:right;background:none;border:0;color:#fff;font-size:18px;cursor:pointer">&times;</button>';
      n.querySelector('button').onclick = function () { n.remove(); pill(); };
      d.body.appendChild(n);
    }
    var show = function () { if (on === null) pill(); else note(false); };
    if (d.body) show(); else d.addEventListener('DOMContentLoaded', show);
  })(window, document);
</script>

<!-- Language preference storage + auto-detection on first visit -->
<script>
  (function() {
    const path = window.location.pathname;
    const onFr = path.startsWith('/fr');

    // Always update stored preference to match current page language
    localStorage.setItem('yv-lang', onFr ? 'fr' : 'en');

    // Auto-redirect only on first visit to root (no stored preference yet)
    if (path !== '/') return;
    const stored = localStorage.getItem('yv-lang');
    // If user explicitly chose English, never redirect
    if (stored === 'en') return;
    // First-ever visit: check browser language
    if (!stored) {
      const lang = (navigator.language || 'en').toLowerCase();
      if (lang.startsWith('fr')) {
        localStorage.setItem('yv-lang', 'fr');
        window.location.replace('/fr/');
      }
    }
  })();
</script>

<!-- Collapse sidebar groups by default, keep active one open -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Find all sidebar group <details> elements
    const sidebarDetails = document.querySelectorAll('.sidebar-content details');
    sidebarDetails.forEach(function(detail) {
      // Check if any link inside is the current page
      const currentLink = detail.querySelector('a[aria-current="page"]');
      if (!currentLink) {
        detail.removeAttribute('open');
      }
    });
  });
</script>

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "YeahSight",
  "url": siteUrl,
  "description": "Structured insights on how society works and where it is heading — in English and French. By HappyBein.",
  "inLanguage": ["en", "fr"]
})} />

<!-- TTS button injected at body level to avoid clipping -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  if (document.querySelector('.hero')) return;
  if (document.querySelector('.yv-audio')) return;   // recorded audio replaces browser text-to-speech

  const lang = document.documentElement.lang || 'en';
  const isFr = lang.startsWith('fr');
  const ttsLang = isFr ? 'fr-FR' : 'en-GB';
  const L = {
    listen:  isFr ? 'Écouter'  : 'Listen',
    pause:   isFr ? 'Pause'    : 'Pause',
    resume:  isFr ? 'Reprendre': 'Resume',
    stop:    isFr ? 'Arrêter'  : 'Stop',
  };

  const bar = document.createElement('div');
  bar.id = 'yv-tts-bar';
  bar.style.display = 'flex';
  bar.innerHTML = `
    <button id="yv-play">
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/></svg>
      <span>${L.listen}</span>
    </button>
    <div id="yv-tts-controls">
      <button id="yv-pause">
        <svg id="yv-pause-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
        <span id="yv-pause-label">${L.pause}</span>
      </button>
      <button id="yv-stop">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h12v12H6z"/></svg>
        <span>${L.stop}</span>
      </button>
      <div id="yv-tts-progress-wrap"><div id="yv-tts-progress"></div></div>
    </div>`;
  document.body.appendChild(bar);

  const playBtn    = document.getElementById('yv-play');
  const pauseBtn   = document.getElementById('yv-pause');
  const stopBtn    = document.getElementById('yv-stop');
  const controls   = document.getElementById('yv-tts-controls');
  const progress   = document.getElementById('yv-tts-progress');
  const pauseIcon  = document.getElementById('yv-pause-icon');
  const pauseLabel = document.getElementById('yv-pause-label');

  let sentences = [], idx = 0, bestVoice = null;

  // Preferred voice names in order — most natural first
  const preferredEN = [
    'Google UK English Female',
    'Google UK English Male',
    'Microsoft Libby Online (Natural)',
    'Microsoft Ryan Online (Natural)',
    'Microsoft Sonia Online (Natural)',
    'Microsoft Aria Online (Natural)',
    'Google US English',
    'Samantha', // macOS/iOS
  ];
  const preferredFR = [
    'Google français',
    'Microsoft Henri Online (Natural)',
    'Microsoft Denise Online (Natural)',
    'Microsoft Julie Online (Natural)',
    'Thomas', // macOS
    'Amélie', // macOS
  ];

  function pickVoice(voices) {
    const preferred = isFr ? preferredFR : preferredEN;
    // Try exact name match first
    for (const name of preferred) {
      const v = voices.find(v => v.name === name);
      if (v) return v;
    }
    // Try partial name match (catches regional variants)
    for (const name of preferred) {
      const v = voices.find(v => v.name.includes(name.split(' ')[1] || name));
      if (v) return v;
    }
    // Fall back to any voice matching the language
    return voices.find(v => v.lang.startsWith(isFr ? 'fr' : 'en')) || voices[0];
  }

  function loadVoices() {
    const voices = speechSynthesis.getVoices();
    if (voices.length) bestVoice = pickVoice(voices);
  }

  loadVoices();
  speechSynthesis.addEventListener('voiceschanged', loadVoices);

  function getTexts() {
    const el = document.querySelector('.sl-markdown-content');
    if (!el) return [];
    return Array.from(el.querySelectorAll('p, h2, h3, h4, li'))
      .map(e => e.textContent?.trim()).filter(t => t && t.length > 3);
  }

  function updateProgress() {
    if (progress && sentences.length)
      progress.style.width = (idx / sentences.length * 100) + '%';
  }

  function speakNext() {
    if (idx >= sentences.length) { stop(); return; }
    const u = new SpeechSynthesisUtterance(sentences[idx]);
    u.lang = ttsLang;
    u.rate = 0.92;
    u.pitch = 1.0;
    if (bestVoice) u.voice = bestVoice;
    u.onend = () => { idx++; updateProgress(); speakNext(); };
    u.onerror = () => { idx++; speakNext(); };
    speechSynthesis.speak(u);
  }

  function start() {
    if (!('speechSynthesis' in window)) { alert('Text-to-speech is not supported in this browser.'); return; }
    speechSynthesis.cancel();
    // Reload voices in case they loaded late
    if (!bestVoice) loadVoices();
    sentences = getTexts();
    idx = 0;
    playBtn.style.display = 'none';
    controls.style.display = 'flex';
    speakNext();
  }

  function togglePause() {
    if (speechSynthesis.paused) {
      speechSynthesis.resume();
      pauseIcon.innerHTML = '<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>';
      pauseLabel.textContent = L.pause;
    } else {
      speechSynthesis.pause();
      pauseIcon.innerHTML = '<path d="M8 5v14l11-7z"/>';
      pauseLabel.textContent = L.resume;
    }
  }

  function stop() {
    speechSynthesis.cancel();
    idx = 0;
    if (progress) progress.style.width = '0%';
    playBtn.style.display = 'flex';
    controls.style.display = 'none';
    pauseIcon.innerHTML = '<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>';
    pauseLabel.textContent = L.pause;
  }

  playBtn.addEventListener('click', start);
  pauseBtn.addEventListener('click', togglePause);
  stopBtn.addEventListener('click', stop);
  window.addEventListener('beforeunload', () => speechSynthesis.cancel());
});
</script>

<!-- All tools pill — injected directly onto body to avoid fixed-position containment issues -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  const isFr = document.documentElement.lang?.startsWith('fr');
  const label = '← HappyBein';
  const pill = document.createElement('a');
  pill.href = 'https://happybein.com';
  pill.textContent = label;
  pill.setAttribute('aria-label', label);
  pill.style.cssText = 'position:fixed;bottom:14px;left:14px;height:30px;padding:0 12px;border-radius:15px;background:#2ABFBF;color:#fff;display:flex;align-items:center;gap:5px;font-family:Nunito,Arial,sans-serif;font-weight:700;font-size:12px;text-decoration:none;box-shadow:0 2px 8px rgba(42,191,191,0.4);z-index:99998;opacity:0.85;';
  pill.addEventListener('mouseover', () => pill.style.opacity = '1');
  pill.addEventListener('mouseout',  () => pill.style.opacity = '0.85');
  // Hide while the reader scrolls down (so it never sits over the text), show again on scroll up.
  pill.style.transition = 'transform .25s ease, opacity .25s ease';
  let lastY = window.scrollY;
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    const down = y > lastY && y > 120;
    pill.style.transform = down ? 'translateY(70px)' : '';
    pill.style.pointerEvents = down ? 'none' : '';
    lastY = y;
  }, { passive: true });
  document.body.appendChild(pill);
});
</script>
