  function clearGaCookies() {
    var names = d.cookie.split('; ').map(function (c) { return c.split('=')[0]; }).filter(function (n) { return n === '_ga' || n.indexOf('_ga_') === 0 || n === '_gid'; });
    var p = w.location.hostname.split('.'), doms = ['', '; domain=' + w.location.hostname];
    if (p.length >= 2) doms.push('; domain=.' + p.slice(-2).join('.'));
    names.forEach(function (n) { doms.forEach(function (dm) { d.cookie = n + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/' + dm; }); });
  }

  /* ---- Google Consent Mode (default state is decided before the page's own gtag('config')) ---- */
  w.dataLayer = w.dataLayer || [];
  function gtag() { w.dataLayer.push(arguments); }
  if (!w.gtag) w.gtag = gtag;
  var stored = read(), loaded = false;
  var def = { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: stored === 'granted' ? 'granted' : 'denied' };
  gtag('consent', 'default', def);

  function loadGA() {
    if (loaded) return;
    loaded = true;
    var s = d.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA;
    (d.head || d.documentElement).appendChild(s);
  }
  function apply(v) {
